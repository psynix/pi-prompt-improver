{
  "name": "pi-prompt-improver",
  "version": "0.1.1",
  "description": "Pi Agent extension that improves prompts with a configurable optimizer model before execution.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/psynix/pi-prompt-improver#readme",
  "bugs": {
    "url": "https://github.com/psynix/pi-prompt-improver/issues"
  },
  "license": "MIT",
  "author": "psynix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psynix/pi-prompt-improver.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "extensions/"
  ],
  "type": "module",
  "exports": {
    ".": "./extensions/response-improver/index.ts"
  },
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.79.0",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0",
    "vite-plus": "^0.1.24"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.79.0",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  },
  "pi": {
    "extensions": [
      "./extensions/response-improver/index.ts"
    ]
  }
}
